# 放在已有 HTTPS server 块内，安装时将 CPA_UPSTREAM 替换为已有 CPA 内网地址；不是管理端口。
location = /v1/embeddings {
    client_max_body_size 2m;
    client_body_buffer_size 2m;
    # 先校验模型和请求种类，再转入宿主执行链，不能让未知模型回落到聊天。
    rewrite_by_lua_block {
        local function reject(status)
            ngx.status = status
            ngx.header.content_type = 'application/json'
            ngx.say('{"error":{"message":"Invalid embedding request","type":"invalid_request_error"}}')
            return ngx.exit(status)
        end
        if ngx.req.get_method() ~= 'POST' then return reject(405) end
        if ngx.var.args and ngx.var.args ~= '' then return reject(400) end
        ngx.req.read_body()
        local raw = ngx.req.get_body_data()
        if not raw then return reject(400) end
        local cjson = require 'cjson.safe'
        local body = cjson.decode(raw)
        if type(body) ~= 'table' or (body.stream ~= nil and body.stream ~= false) then return reject(400) end
        if type(body.model) ~= 'string' or #body.model == 0 or #body.model > 255 then return reject(400) end
        -- 只转发向量协议字段；重编码消除重复的 model 字段在宿主和入口被不同解释的风险。
        local allowed = {model=true,input=true,dimensions=true,encoding_format=true,user=true,stream=true,input_type=true}
        for k in pairs(body) do if not allowed[k] then return reject(400) end end
        local size = 0
        if type(body.input) == 'string' then size = #body.input
        elseif type(body.input) == 'table' then
            if #body.input < 1 or #body.input > 32 then return reject(400) end
            for k,v in pairs(body.input) do
                if type(k) ~= 'number' or k < 1 or k > #body.input or type(v) ~= 'string' or #v == 0 then return reject(400) end
                size = size + #v
            end
        else return reject(400) end
        if size == 0 then return reject(400) end
        if size > 262144 then return reject(413) end
        -- 仅向正在运行的插件询问该模型是否可用，不传客户端凭据/输入；未注册或已停用一律拒绝。
        local rule = ngx.location.capture('/_cpa_embedding_eligible', {method=ngx.HTTP_GET, args={model=body.model}})
        if rule.status == 403 then return reject(400) end
        if rule.status ~= 200 or rule.body ~= 'eligible-v3' then return reject(503) end
        ngx.req.set_body_data(cjson.encode(body))
    }
    proxy_pass http://CPA_UPSTREAM/v1/responses;
    proxy_http_version 1.1;
    proxy_set_header X-Cpr-Operation embeddings;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Cookie "";
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 120s;
}

# 这是只供 nginx 子请求使用的精确路径，不公开上游资源入口或任何通用管理路径。
location = /_cpa_embedding_eligible {
    internal;
    proxy_pass_request_headers off;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_pass http://CPA_UPSTREAM/v0/resource/plugins/cpr-gemini-embeddings/eligible;
}
location = /embedding-models { return 302 /embedding-models/; }
location = /embedding-models/ {
    limit_except GET { deny all; }
    proxy_pass_request_headers off;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_pass http://CPA_UPSTREAM/v0/resource/plugins/cpr-gemini-embeddings/panel;
    add_header X-Frame-Options DENY always;
}
# 仅透传当前管理员提供的认证，不注入管理密钥，也不接受 URL 参数或 Cookie 身份。
location = /embedding-models/api {
    if ($args != "") { return 400; }
    limit_except GET POST { deny all; }
    client_max_body_size 4k;
    proxy_pass_request_headers off;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Content-Type application/json;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_pass http://CPA_UPSTREAM/v0/management/cpa-embeddings/models;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Credentials;
    add_header Cache-Control no-store always;
}
